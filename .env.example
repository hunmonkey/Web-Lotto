# Web-Lotto 환경변수 보기틀
#
# 이 파일을 .env 로 복사한 뒤 값을 채운다.  Windows: copy .env.example .env
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않는다. 실제 값은 Rule_PW.txt 에 함께 적어 둔다.

# 로그인 쿠키에 서명할 비밀값.  .venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=여기에_긴_임의_문자열을_넣으세요
# 로그인 비밀번호의 bcrypt 해시(아이디는 없다). 원문은 어디에도 적지 않는다.  .venv/Scripts/python.exe -m app.cli hash-password
# ★ 작은따옴표로 감싼다. 해시에 든 $ 뒤를 도커/셸이 변수로 풀어 지우면 로그인이 안 된다.
LOGIN_PASSWORD_HASH='여기에_해시를_넣으세요'
# 로그인한 뒤 이 시간이 지나면 다시 로그인한다.
SESSION_MAX_HOURS=12
# 쿠키를 https 에서만. 운영(https://lotto.jaehoon.org)에서는 true. 개발 PC 에서 http 로 볼 때만 false.
SESSION_COOKIE_SECURE=true
# 당첨번호 · 즐겨찾기가 쌓이는 SQLite 파일(lotto.sqlite)의 폴더. 안 적으면 실행 폴더의 data/
# 운영 서버(도커)에서는 '서버 쪽 경로' 를 적는다(docker-compose 가 컨테이너 안에는 /srv/data 로 붙인다).
# DATA_DIR=/mnt/user/appdata/Web-Lotto-data

# ---------- 도커 (운영 서버에서만 쓴다. 앱 자체는 읽지 않는다) ----------
# 서버 안에서 앱이 쓰는 바깥 포트(안쪽은 7682 고정). 2026-11-07 재훈 님 결정.
# APP_PORT=7682
# 운영 Unraid 서버: 172.17.0.1 (docker0. NPM 이 이 주소로 들어온다). 0.0.0.0 은 쓰지 않는다 - 프록시를 건너뛰고 http 로 붙게 된다.
# BIND_ADDR=172.17.0.1
# X-Forwarded-* 헤더를 믿을 프록시 주소 대역. 도커 사설 대역이 기본.
# FORWARDED_ALLOW_IPS=172.16.0.0/12
